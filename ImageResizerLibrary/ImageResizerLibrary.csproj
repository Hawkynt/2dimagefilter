<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <Version>1.1.3</Version>
    <AssemblyTitle>ImageResizer</AssemblyTitle>
    <Company>»SynthelicZ«</Company>
    <Product>ImageResizer</Product>
    <Copyright>Copyright © 2008-2019 Hawkynt</Copyright>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
    <DefineConstants>TRACE;DEBUG;NETFX_45</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <Import Project="..\VersionSpecificSymbols.Common.prop" />
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <!-- Resolve the upstream library via ProjectReference if we can find the sibling repo, else
       fall back to the published NuGet. Two probe locations supported, in priority order:
         1. local-dev layout: sibling repos checked out next to each other
            (../../C..FrameworkExtensions/System.Drawing.Extensions/)
         2. CI layout: sibling cloned into a subdir of the consumer workspace
            (../.sibling/C..FrameworkExtensions/) because GitHub Actions' actions/checkout
            `path:` parameter cannot escape the workspace.
       NuGet fallback only fires when neither path resolves.
       (The dot-notation in this comment avoids XML's no-double-hyphen rule; the actual
       paths in the conditions below use the correct repo name.) -->
  <PropertyGroup>
    <FrameworkExtensionsRoot Condition="'$(FrameworkExtensionsRoot)' == '' And Exists('..\..\C--FrameworkExtensions\System.Drawing.Extensions\System.Drawing.Extensions.csproj')">..\..\C--FrameworkExtensions</FrameworkExtensionsRoot>
    <FrameworkExtensionsRoot Condition="'$(FrameworkExtensionsRoot)' == '' And Exists('..\.sibling\C--FrameworkExtensions\System.Drawing.Extensions\System.Drawing.Extensions.csproj')">..\.sibling\C--FrameworkExtensions</FrameworkExtensionsRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(FrameworkExtensionsRoot)' != ''">
    <ProjectReference Include="$(FrameworkExtensionsRoot)\System.Drawing.Extensions\System.Drawing.Extensions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FrameworkExtensionsRoot)' == ''">
    <PackageReference Include="FrameworkExtensions.System.Drawing" Version="1.0.1" />
  </ItemGroup>
</Project>