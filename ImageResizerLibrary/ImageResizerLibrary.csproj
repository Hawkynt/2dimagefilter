<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <Version>1.1.3</Version>
    <AssemblyTitle>ImageResizer</AssemblyTitle>
    <Company>»SynthelicZ«</Company>
    <Product>ImageResizer</Product>
    <Copyright>Copyright © 2008-2019 Hawkynt</Copyright>
    <AssemblyVersion>1.1.3.3</AssemblyVersion>
    <FileVersion>1.1.3.3</FileVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
    <DefineConstants>TRACE;DEBUG;NETFX_45</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <Import Project="..\VersionSpecificSymbols.Common.prop" />
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <!-- Project reference during active development so changes to the upstream
         IKernelResampler etc. are visible without an intermediate NuGet pack/publish.
         Swap back to a PackageReference once the upstream is packed + published. -->
    <ProjectReference Include="..\..\C--FrameworkExtensions\System.Drawing.Extensions\System.Drawing.Extensions.csproj" />
  </ItemGroup>
</Project>