<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NoStandardLibraries>false</NoStandardLibraries>
    <AssemblyName>2dImageFilter</AssemblyName>
    <TargetFramework>net48</TargetFramework>
    <AssemblyTitle>2d Image Filter Plugin</AssemblyTitle>
    <Company>Hawkynt</Company>
    <Product>PixelArtScalingPlugin</Product>
    <Description>Manipulates images using the 2dimagefilter library.</Description>
    <Copyright>Copyright ©2008-2019 Hawkynt</Copyright>
    <!-- Base version only; the revision is stamped by CI. See ImageResizer.csproj. -->
    <Version>1.1.3</Version>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>9</LangVersion>
    <!-- Resources.resx embeds PNGs (non-string resources). The .NET 8 SDK's WinForms targets
         refuse to generate the .resources file unless we opt into the pre-serialized path and
         reference System.Resources.Extensions. Needed for CI (dotnet build) only — msbuild.exe
         via Visual Studio follows the legacy path and builds without this. -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugType>full</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE;DEBUG;NETFX_35</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>
  <Import Project="..\VersionSpecificSymbols.Common.prop" />
  <ItemGroup>
    <Reference Include="PaintDotNet.Base">
      <HintPath>External\PaintDotNet.Base.dll</HintPath>
    </Reference>
    <Reference Include="PaintDotNet.Core">
      <HintPath>External\PaintDotNet.Core.dll</HintPath>
    </Reference>
    <Reference Include="PaintDotNet.Data">
      <HintPath>External\PaintDotNet.Data.dll</HintPath>
    </Reference>
    <Reference Include="PaintDotNet.Effects">
      <HintPath>External\PaintDotNet.Effects.dll</HintPath>
    </Reference>
    <Reference Include="PaintDotNet.Framework">
      <HintPath>External\PaintDotNet.Framework.dll</HintPath>
    </Reference>
    <Reference Include="PaintDotNet.Resources">
      <HintPath>External\PaintDotNet.Resources.dll</HintPath>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ImageResizerLibrary\Classes\ReflectionUtils.cs" Link="Classes\ReflectionUtils.cs" />
    <Compile Update="Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\App.png" />
    <None Include="Resources\Width.png" />
    <None Include="Resources\Height.png" />
    <None Include="Resources\Resize.png" />
    <None Include="Resources\Switch.png" />
    <None Include="Resources\Repeat.png" />
    <None Include="Resources\Horizontal.png" />
    <None Include="Resources\Vertical.png" />
    <None Include="Resources\ProgressCircularBlue.gif" />
    <None Include="Resources\Clipboard.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Documents\Paint.NET - Effects Plugin Template - Sepcot.com %282014-10-26 12-21-06%29.htm" />
    <Content Include="External\PaintDotNet.Base.dll" />
    <Content Include="External\PaintDotNet.Base.pdb" />
    <Content Include="External\PaintDotNet.Core.dll" />
    <Content Include="External\PaintDotNet.Core.pdb" />
    <Content Include="External\PaintDotNet.Data.dll" />
    <Content Include="External\PaintDotNet.Data.pdb" />
    <Content Include="External\PaintDotNet.Effects.dll" />
    <Content Include="External\PaintDotNet.Effects.pdb" />
    <Content Include="External\PaintDotNet.Framework.dll" />
    <Content Include="External\PaintDotNet.Framework.pdb" />
    <Content Include="External\PaintDotNet.Resources.dll" />
    <Content Include="External\PaintDotNet.Resources.pdb" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ImageResizerLibrary\ImageResizerLibrary.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Bundles every reachable dependency assembly into the plugin DLL as a compressed
         embedded resource and registers an AppDomain.AssemblyResolve hook at module init.
         Result: ship a single 2dImageFilter.dll. -->
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="Fody" Version="6.8.1" PrivateAssets="all" />
    <!-- Required by GenerateResourceUsePreserializedResources (see PropertyGroup above). -->
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>
</Project>